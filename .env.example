# ========================================================
# CivicSolve Environment Configuration Template
# Copy this file to .env and configure your production values
# ========================================================

# [Server Port]
PORT=3001

# [Google Gemini AI API Key] (Optional)
# If provided, live Gemini 1.5 Flash models will power real-time problem triage and chatbot intelligence.
# If omitted, CivicSolve automatically switches to its high-fidelity deterministic rule-based engine.
GEMINI_API_KEY=

# [Remote Backend API URL] (Optional)
# Only required if deploying the React frontend separately from the Express backend.
# Example: https://api.civicsolve.org
VITE_API_URL=

# [Supabase Integration] (Optional)
# If configured, challenges sync with Supabase cloud PostgreSQL.
# If omitted, the platform uses local demonstration data covering all 24 Jharkhand districts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=